# ==============================================================================
# FoodieHub Environment Variables Configuration
# Copy this file to .env for local customization
# ==============================================================================

# Shared JWT Secret Key (Must be at least 32 characters)
JWT_SECRET=foodiehub-cloudnative-super-secure-jwt-secret-key-32bytes-min!
JWT_ALGORITHM=HS256

# Microservice Service Ports (Local development)
USER_SERVICE_PORT=8001
RESTAURANT_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
DELIVERY_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
GATEWAY_PORT=80

# Inter-Service Communication URLs (Local Development defaults)
USER_SERVICE_URL=http://localhost:8001
RESTAURANT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
DELIVERY_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005

# In Docker Compose, the service discovery URLs resolve via container service names:
# USER_SERVICE_URL=http://user-service:8001
# RESTAURANT_SERVICE_URL=http://restaurant-service:8002
# ORDER_SERVICE_URL=http://order-service:8003
# DELIVERY_SERVICE_URL=http://delivery-service:8004
# NOTIFICATION_SERVICE_URL=http://notification-service:8005

# General Settings
LOG_LEVEL=INFO
TAX_RATE=0.05
